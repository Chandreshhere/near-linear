# ---------------------------------------------------------------------------
# Frontend configuration. Copy to `.env.local` to override.
# The app ships as a STANDALONE FRONTEND: with no .env file at all it runs
# fully client-side, with no backend and no network calls.
# ---------------------------------------------------------------------------

# Which SyncTransport the local-first engine boots with (src/lib/data/transport.ts).
#
#   local  (DEFAULT — also the value used when this variable is unset)
#          src/lib/data/transports/local.ts. A complete sync authority inside
#          the browser: IndexedDB is the authority, mutations are applied and
#          validated locally, sync ids come from a persisted counter, and other
#          tabs stay in realtime sync over
#          BroadcastChannel("linear-recon-sync"). ZERO server dependency —
#          no fetch, no EventSource; the app boots to "ready" offline.
#          A brand-new browser bootstraps EMPTY and creates its workspace in
#          onboarding — nothing is seeded (see "Demo data" below).
#
#   http   src/lib/data/transports/http.ts. Speaks the documented wire contract
#          (see BACKEND_API.md): GET /api/sync/bootstrap (NDJSON stream),
#          POST /api/sync/mutation, GET /api/sync/events (SSE). Used to drive
#          the dev-only mock in src/app/api/sync/* — and, once
#          NEXT_PUBLIC_API_BASE_URL points at it, a real backend.
#
NEXT_PUBLIC_SYNC_TRANSPORT=local

# Origin (optionally with a path prefix) that HttpTransport prefixes onto every
# sync request. Empty/unset = same origin, which is what the dev mock needs.
# Only read when NEXT_PUBLIC_SYNC_TRANSPORT=http. No trailing slash needed.
#
#   NEXT_PUBLIC_API_BASE_URL=https://api.example.com
#
NEXT_PUBLIC_API_BASE_URL=

# ---------------------------------------------------------------------------
# Demo data
# ---------------------------------------------------------------------------
# There is NO environment switch for demo data, on purpose: seeding is a
# per-browser decision, not a per-deployment one, so it is a URL instead.
#
#   http://localhost:3000/app?demo=1   creates/opens the demo workspace
#   http://localhost:3000/?demo=1      same, from the landing page
#
# Inside a workspace, Settings -> Preferences -> Workspace data offers
# "Load demo data" (merge the sample set into the workspace you are in) and
# "Reset workspace" (wipe this browser's copy and return to onboarding).

# ---------------------------------------------------------------------------
# Server-side: MCP server + the chat webhook
# ---------------------------------------------------------------------------
# These are NOT NEXT_PUBLIC_ — they never reach the browser, and they are read
# per request, so changing one needs a restart but not a rebuild.
# Full documentation: BACKEND_API.md sections 7 and 11.

# Shared secret for the MCP server at POST /api/mcp. When set, every request
# must carry `Authorization: Bearer <MCP_TOKEN>`; without it the endpoint
# answers 401. Unset, the endpoint is OPEN -- which is fine on localhost and
# nowhere else, because its tools create and modify workspace data.
#
#   MCP_TOKEN=a-long-random-string
#
MCP_TOKEN=

# Workspace member that MCP and webhook writes are attributed to -- a name,
# an email or a user id. Unset, the workspace's first member is used. (The
# mutation contract carries no authenticated actor; see BACKEND_API.md 6.6.)
#
#   MCP_ACTOR=yatharth.kaushal@synquic.in
#
MCP_ACTOR=

# HMAC secret for POST /api/integrations/inbound. When set, every request must
# carry `X-Signature: sha256=<hex>` -- HMAC-SHA256 over the raw body, or over
# `<timestamp>.<rawBody>` when `X-Timestamp` (unix seconds) is also sent, in
# which case anything more than 300s off the clock is rejected. Unset, the
# receiver accepts unsigned requests: development only.
#
#   INTEGRATIONS_SIGNING_SECRET=another-long-random-string
#
INTEGRATIONS_SIGNING_SECRET=

# The SERVER's channel -> team routing rules, as JSON. The rules edited on
# Settings -> Integrations live in that browser's localStorage and are not
# reachable from a server route, so the receiver reads its own from here.
# Only `team` is required; provider/workspace/channel default to "*" and
# trigger defaults to "command".
#
#   INTEGRATIONS_RULES='[{"provider":"slack","channel":"bugs","team":"PGME","trigger":"all","priority":1}]'
#
# Unset, ONE built-in rule applies: every channel -> the workspace's first
# team, triggered by a message starting with "/task".
#
INTEGRATIONS_RULES=
